{
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check && deno test --allow-env --allow-net --allow-read",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve --allow-net --allow-env --allow-read _fresh/server.js",
    "test": "deno test --allow-env --allow-net --allow-read",
    "update": "deno run -A -r jsr:@fresh/update .",
    "prepare": "deno run -A npm:husky"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@grpc/grpc-js": "npm:@grpc/grpc-js@^1.14.3",
    "protobufjs": "npm:protobufjs@^8.0.0",
    "@grpc/proto-loader": "npm:@grpc/proto-loader@^0.8.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "@preact/signals": "npm:@preact/signals@^2.8.2",
    "lucide-preact": "npm:lucide-preact@^0.577.0",
    "@tabler/icons-preact": "npm:@tabler/icons-preact@^3.40.0/dist/esm/icons",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.2.1",
    "@fontsource/fira-code": "npm:@fontsource/fira-code",
    "@shikijs/core": "npm:@shikijs/core@^4.0.2",
    "@shikijs/engine-javascript": "npm:@shikijs/engine-javascript@^4.0.2",
    "@shikijs/monaco": "npm:@shikijs/monaco@^4.0.2",
    "@shikijs/themes": "npm:@shikijs/themes@^4.0.2",
    "@std/tar": "jsr:@std/tar@^0.1.10",
    "@std/yaml": "jsr:@std/yaml@^1.0.12",
    "cache/mod.ts": "jsr:@denosaurs/cache@^0.2.15",
    "preact": "npm:preact@10.29.0",
    "tailwindcss": "npm:tailwindcss@^4.2.1",
    "fresh": "jsr:@fresh/core@^2.2.0",
    "vite": "npm:vite@^7.3.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "monaco-editor/": "npm:/monaco-editor@0.55.1/"
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"]
}
